# Required in every environment.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Required for production; during local development, when omitted, API requests
# use the current origin. Set this to the deployed API origin for production
# (for example, https://mezmarket-api.onrender.com).
VITE_API_URL=

# Optional during local development: proxy /api requests to a local API.
VITE_API_PROXY=<api url, set proxy the api>
